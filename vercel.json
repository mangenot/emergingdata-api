{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "x-api-key, content-type"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/macro-run",
      "schedule": "0 5 3 * *"
    },
    {
      "path": "/api/global-run",
      "schedule": "30 5 3 * *"
    },
    {
      "path": "/api/score-run",
      "schedule": "0 6 5 * *"
    }
  ]
}
